# Supabase → Project Settings → API (or "Connect")
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The public "anon" / "publishable" key. Never put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: the address printed into collar QR codes. Set this once you have a
# domain so tags keep working even if you change hosts. Defaults to the site's own address.
VITE_PUBLIC_URL=

# Optional: shown on public animal pages ("If they look hurt, message us: ...")
VITE_CONTACT=

# Optional: set to true after enabling Google in Supabase → Authentication → Providers
VITE_GOOGLE_SIGNIN=false
